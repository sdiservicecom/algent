# Upstash Redis (via Vercel Marketplace) — auto-injecté quand tu connectes
# l'intégration Upstash au projet. Pour le dev local, fais
# `vercel env pull .env.local` après avoir lié le projet (`vercel link`).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Aliases legacy (Vercel KV ancienne génération) — supportés en fallback.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Secret JWT (générer avec: openssl rand -base64 32)
AUTH_SECRET="change-me-32-bytes-minimum-please-rotate"

# Secret des cron Vercel — Vercel l'envoie auto en Authorization: Bearer <CRON_SECRET>
CRON_SECRET="change-me"
