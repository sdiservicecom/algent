# PostgreSQL — Vercel Postgres / Neon / Supabase
# Pour Vercel serverless ajoutez `?pgbouncer=true&connection_limit=1` si pooler.
DATABASE_URL="postgresql://user:password@host:5432/algent?schema=public"

# Secret JWT (générer avec: openssl rand -base64 32)
AUTH_SECRET="change-me-32-bytes-minimum-please-rotate"

# Secret pour authentifier les cron Vercel (Settings → Environment Variables)
# Vercel l'envoie automatiquement dans Authorization: Bearer <CRON_SECRET>
CRON_SECRET="change-me"
