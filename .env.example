# Vercel KV (Upstash Redis) — auto-injecté quand tu ajoutes "KV" au projet
# sur le dashboard Vercel. Pour le dev local, fais `vercel env pull .env.local`
# après avoir lié le projet (`vercel link`).
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Secret JWT (générer avec: openssl rand -base64 32)
AUTH_SECRET="change-me-32-bytes-minimum-please-rotate"

# Secret des cron Vercel — Vercel l'envoie auto en Authorization: Bearer <CRON_SECRET>
CRON_SECRET="change-me"
